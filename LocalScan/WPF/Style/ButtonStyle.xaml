<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="../Icons/Delete.xaml" />
        <ResourceDictionary Source="../Icons/Edit.xaml" />
        <ResourceDictionary Source="../Icons/AccountPlus.xaml" />
        <ResourceDictionary Source="../Icons/DatabasePlus.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" x:Key="EditBtn">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Border" BorderThickness="1" BorderBrush="#80000000" CornerRadius="3" Background="Transparent">
                        <Rectangle x:Name="Rect" Fill="{StaticResource Yellow}" Height="24" Width="24" Margin="4">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Fill" Visual="{StaticResource Edit}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#40d3d3d3"/>
                            <Setter TargetName="Rect" Property="Fill" Value="{StaticResource DarkYellow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" x:Key="DeleteBtn">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Border" BorderThickness="1" BorderBrush="#80000000" CornerRadius="3" Background="Transparent">
                        <Rectangle x:Name="Rect" Fill="Red" Height="24" Width="24" Margin="4">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Fill" Visual="{StaticResource Delete}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#40d3d3d3"/>
                            <Setter TargetName="Rect" Property="Fill" Value="DarkRed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" x:Key="AddBtn">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Border" BorderThickness="1" BorderBrush="#80000000" CornerRadius="3" Background="Transparent">
                        <Rectangle x:Name="Rect" Fill="{StaticResource Green}" Height="24" Width="34" Margin="4">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Fill" Visual="{StaticResource AccountPlus}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#40d3d3d3"/>
                            <Setter TargetName="Rect" Property="Fill" Value="{StaticResource DarkGreen}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" x:Key="AddBtn2">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Border" BorderThickness="1" BorderBrush="#80000000" CornerRadius="3" Background="Transparent">
                        <Rectangle x:Name="Rect" Fill="{StaticResource Green}" Height="24" Width="24" Margin="4">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Fill" Visual="{StaticResource DatabasePlus}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#40d3d3d3"/>
                            <Setter TargetName="Rect" Property="Fill" Value="{StaticResource DarkGreen}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>